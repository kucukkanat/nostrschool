---
/**
 * Owner: shell agent. Landing page, laid out like the first spread of a field notebook:
 * an editorial hero (headline with a highlighter mark, the network diagram printed on a halftone
 * plate, Nos the ostrich), how it works, the course as a notebook table of contents, and tools.
 */
import { getDictionary } from "@nostrschool/i18n";
import { Mascot } from "@nostrschool/mascot";
import ContinueLink from "~/components/shell/ContinueLink.svelte";
import CourseMap from "~/components/shell/CourseMap.svelte";
import HeroNetwork from "~/components/shell/HeroNetwork.svelte";
import { chapterLinks } from "~/components/shell/lib/links";
import ToolCards from "~/components/shell/ToolCards.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { href, mascotRive } from "~/lib/href";
import { assertLocale, localeStaticPaths } from "~/lib/locale";

export const getStaticPaths = localeStaticPaths;
const locale = assertLocale(Astro.params.locale);
const t = getDictionary(locale).common;
const chapters = chapterLinks(locale);

// Split the headline around the highlighted phrase; an untranslated mark just means no mark.
const markAt = t.home.title.indexOf(t.home.titleMark);
const title =
  markAt < 0 || t.home.titleMark === ""
    ? { before: t.home.title, mark: "", after: "" }
    : {
        before: t.home.title.slice(0, markAt),
        mark: t.home.titleMark,
        after: t.home.title.slice(markAt + t.home.titleMark.length),
      };
// Section numbers are decoration (the headings carry the meaning), like a zine's running heads.
const sectionNo = (n: number) => String(n).padStart(2, "0");
// The "how it works" notes are lettered (A, B, C) so they never reuse the section numbers.
const noteLetter = (i: number) => String.fromCharCode("A".charCodeAt(0) + i);
---

<BaseLayout locale={locale} title={t.site.name} fullBleed>
  <section class="hero" aria-labelledby="home-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow kicker">{t.home.eyebrow}</p>
        <h1 id="home-title" data-testid="home-title">
          {title.before}{title.mark !== "" && <mark>{title.mark}</mark>}{title.after}
        </h1>
        <p class="lead">{t.home.lead}</p>
        <div class="ctas">
          <ContinueLink client:idle locale={locale} chapters={chapters} />
          <a class="secondary" href={href(locale, "tools")} data-testid="home-tools"
            >{t.home.ctaTools}</a
          >
        </div>
      </div>
      <div class="hero-art">
        <div class="plate halftone" aria-hidden="true"></div>
        <div class="print">
          <HeroNetwork client:visible locale={locale} />
        </div>
        <div class="hero-mascot">
          <Mascot
            client:idle
            locale={locale}
            size="lg"
            pose="wave"
            say={t.home.mascotHello}
            {...mascotRive}
            testid="hero-mascot"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="features-title" data-testid="home-features">
    <h2 id="features-title">
      <span class="section-no" aria-hidden="true">{sectionNo(1)}</span>{t.home.featuresTitle}
    </h2>
    <ol class="features">
      {t.home.features.map((f, i) => (
        <li class="feature" data-testid={`home-feature-${i}`}>
          <span class="feature-num" aria-hidden="true">
            {noteLetter(i)}
          </span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="map-title" data-testid="home-course">
    <h2 id="map-title">
      <span class="section-no" aria-hidden="true">{sectionNo(2)}</span>{t.home.mapTitle}
    </h2>
    <p class="section-intro">{t.home.mapIntro}</p>
    <CourseMap client:visible locale={locale} chapters={chapters} />
  </section>

  <section class="wrap section" aria-labelledby="tools-title" data-testid="home-tools-section">
    <h2 id="tools-title">
      <span class="section-no" aria-hidden="true">{sectionNo(3)}</span>{t.home.toolsTitle}
    </h2>
    <p class="section-intro">{t.home.toolsIntro}</p>
    <ToolCards locale={locale} />
  </section>

  <section class="wrap section">
    <div class="finale">
      <p class="finale-text">{t.learn.intro}</p>
      <ContinueLink client:visible locale={locale} chapters={chapters} testid="home-start-bottom" />
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-inline-size: var(--size-wide);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  /* ── Hero: plain paper, a heavy ink rule underneath like a masthead. */
  .hero {
    padding-block: var(--space-xl) var(--space-3xl);
    border-block-end: var(--border-width-thick) solid var(--color-border-strong);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .kicker {
    margin: 0 0 var(--space-md);
    padding-block-end: var(--space-xs);
    border-block-end: var(--border-width-medium) solid var(--color-border-strong);
    color: var(--color-text);
  }
  h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--font-letter-spacing-display);
  }
  .lead {
    margin: 0 0 var(--space-xl);
    max-inline-size: var(--size-content);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-snug);
    color: var(--color-text-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
  /* Secondary action: same shape as the CTA, but a paper fill. */
  .secondary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-control-lg);
    padding: var(--space-xs) var(--space-lg);
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-family: var(--font-family-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    box-shadow: var(--shadow-pop-sm);
    transition:
      translate var(--motion-duration-press) var(--motion-easing-press),
      box-shadow var(--motion-duration-press) var(--motion-easing-press);
  }
  .secondary:hover {
    translate: calc(var(--size-lift) * -1) calc(var(--size-lift) * -1);
    box-shadow: var(--shadow-lift);
  }
  .secondary:active {
    translate: var(--size-lift) var(--size-lift);
    box-shadow: var(--shadow-pressed);
  }

  /* The diagram is printed on a raised sheet that sits slightly off a teal halftone plate. */
  .hero-art {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block-end: var(--space-2xl);
    /* Room for the plate's misregistration offset, so it never eats the page gutter. */
    padding-inline-end: var(--space-sm);
  }
  .plate,
  .print {
    grid-area: 1 / 1;
    inline-size: 100%;
    max-inline-size: calc(var(--size-rail) * 1.6 + var(--space-xl) * 2);
    border-radius: var(--radius-md);
  }
  .plate {
    translate: var(--space-sm) var(--space-sm);
    background-color: var(--color-secondary-subtle);
    border: var(--border-width-medium) solid var(--color-border-strong);
  }
  .print {
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    border: var(--border-width-medium) solid var(--color-border-strong);
    background: var(--color-surface-raised);
  }
  /* Phones (< tokens.breakpoint.sm = 480px): Nos steps under the sheet, bubble above. */
  .hero-mascot {
    justify-self: start;
    margin-block-start: var(--space-md);
  }
  /* >= tokens.breakpoint.sm: Nos used to hang over the sheet's corner, and with its bubble it
     covered the diagram's lower half on every desktop width. It now sits in its own row under the
     sheet (cleared past the plate's offset), at md size with the bubble beside it, so no width
     can make the two overlap. The Mascot island keeps its column layout; these overrides only
     reshape it here, like ChapterLayout's chapter intro (three classes beat its two). */
  @media (min-width: 480px) {
    .hero-art {
      padding-block-end: 0;
    }
    .hero-mascot {
      --mascot-size-override: var(--size-mascot-md);
      /* Reserve Nos's height (200×220 viewBox) before the island hydrates: no layout shift. */
      min-block-size: calc(var(--size-mascot-md) * 1.1);
      margin-block-start: var(--space-xl);
    }
    .hero-art .hero-mascot :global(.mascot-container) {
      /* Reversed so Nos (second child) comes first, the bubble to its inline end. */
      flex-direction: row-reverse;
      align-items: center;
      gap: var(--space-md);
    }
    .hero-art .hero-mascot :global(.bubble) {
      text-align: start;
    }
    /* Tail points back at Nos instead of down. */
    .hero-art .hero-mascot :global(.bubble::after) {
      left: calc(var(--space-xs) * -1);
      bottom: auto;
      top: 50%;
      transform: translateY(-50%) rotate(135deg);
    }
  }

  /* ── Sections: editorial running heads. */
  .section {
    padding-block: var(--space-3xl) 0;
  }
  /* One running-head pattern for every section: the mono number sits on its own line above. */
  h2 {
    display: grid;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-black);
  }
  .section-no {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-letter-spacing-normal);
    color: var(--color-text-primary);
  }
  .section-intro {
    margin: 0 0 var(--space-xl);
    max-inline-size: var(--size-content);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  /* How it works: three numbered notes under a heavy rule, no boxes. */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-rail)), 1fr));
    gap: var(--space-xl);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }
  .feature {
    padding-block-start: var(--space-sm);
    border-block-start: var(--border-width-thick) solid var(--color-border-strong);
  }
  .feature-num {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }
  .feature h3 {
    margin: var(--space-xs) 0 var(--space-xs);
    font-size: var(--font-size-2xl);
  }
  .feature p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Closing note: a dashed tear-off slip. */
  .finale {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    padding: var(--space-2xl) var(--space-md);
    border: var(--border-width-medium) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .finale-text {
    margin: 0;
    max-inline-size: var(--size-content);
    font-family: var(--font-family-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--font-line-height-snug);
    text-wrap: balance;
  }

  /* >= tokens.breakpoint.lg */
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-3xl) var(--space-4xl);
    }
    .hero-grid {
      grid-template-columns: 3fr 2fr;
    }
    h1 {
      font-size: var(--font-size-6xl);
    }
  }
</style>
