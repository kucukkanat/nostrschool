---
/**
 * Owner: NIP pages agent. /<locale>/nips/<id>/ — one NIP: what it is (status, kinds, tags), an
 * interactive editor for what it defines (with its how-it-works walkthrough), where the course
 * teaches it, related NIPs, and the specification text, collapsed, at the pinned commit.
 */
import { format, formatDate, formatNumber, getDictionary, LOCALES } from "@nostrschool/i18n";
import { NipEditor } from "@nostrschool/nip-editor";
import { getNipMeta, getNipStrings, isNipId, NIP_IDS } from "@nostrschool/nips";
import { getNipDocument, NIP_CORPUS, renderNipMarkdown } from "@nostrschool/nips/corpus";
import { getSpec } from "@nostrschool/nips/specs";
import { loadCourseMap } from "~/components/nips/course";
import { groupRelated, nipNeighbors, relatedEntries } from "~/components/nips/detail";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { href } from "~/lib/href";
import { assertLocale } from "~/lib/locale";

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) => NIP_IDS.map((id) => ({ params: { locale, id } })));

const locale = assertLocale(Astro.params.locale);
const id = Astro.params.id;
const meta = isNipId(id) ? getNipMeta(id) : undefined;
const doc = isNipId(id) ? getNipDocument(id) : undefined;
const spec = isNipId(id) ? getSpec(id) : undefined;
// Fail the build loudly rather than render a half page (getStaticPaths only yields corpus ids).
if (meta === undefined || doc === undefined || spec === undefined)
  throw new Error(`nips/[id]: no corpus entry or spec for "${String(id)}"`);

const dict = getDictionary(locale);
const ui = dict.nips.ui;
const strings = getNipStrings(locale, meta.id);
const title = strings?.title ?? meta.title;
const summary = strings?.summary ?? meta.summary;
const nipTitle = (nip: string) => getNipStrings(locale, nip)?.title ?? getNipMeta(nip)?.title ?? "";
const { repo, commit } = NIP_CORPUS.source;
const shortCommit = commit.slice(0, 7);
const specHtml = renderNipMarkdown(doc.markdown, {
  nipHref: (target, hash) => href(locale, `nips/${target}${hash}`),
  sourceBase: `${repo}/blob/${commit}/`,
});

const known = new Set(NIP_IDS);
const related = groupRelated(
  relatedEntries(spec.related, meta, known, (key) => strings?.text[key]),
);
const { prev, next } = nipNeighbors(NIP_IDS, meta.id);
const courseLinks = (await loadCourseMap(locale))[meta.id] ?? [];
const kindLabel = (k: { kind: number; to?: number }) =>
  k.to === undefined ? `${k.kind}` : `${k.kind}–${k.to}`;
---

<BaseLayout locale={locale} title={`NIP-${meta.id}: ${title}`} description={summary}>
  <a class="back" href={href(locale, "nips")} data-testid="nip-back">← {ui.detail.backToList}</a>

  <header class="head">
    <p class="eyebrow" data-testid="nip-id">NIP-{meta.id}</p>
    <h1 data-testid="nip-title">{title}</h1>
    <p class="badges">
      <span
        class={`badge status ${meta.status}`}
        data-testid="nip-status"
        data-status={meta.status}
        title={ui.statusDescriptions[meta.status]}
        >{ui.statuses[meta.status]}</span
      >
      <span class="badge" data-testid="nip-variant" title={ui.variantDescriptions[spec.variant]}
        >{ui.variants[spec.variant]}</span
      >
      {meta.relay && (
        <span class="badge" data-testid="nip-relay">
          {ui.card.relay}
        </span>
      )}
    </p>
    <p class="summary" data-testid="nip-summary">{summary}</p>
  </header>

  <section class="facts" aria-labelledby="nip-facts-heading" data-testid="nip-facts">
    <h2 id="nip-facts-heading" class="visually-hidden">{ui.detail.facts}</h2>
    <dl>
      <div>
        <dt>{ui.filters.status}</dt>
        <dd>{ui.statusDescriptions[meta.status]}</dd>
      </div>
      {meta.kinds.length > 0 && (
        <div>
          <dt>{ui.detail.kinds}</dt>
          <dd>
            <ul class="chips" data-testid="nip-kinds">
              {meta.kinds.map((k) => (
                <li class="chip" title={k.description}>
                  <a href={href(locale, `nips?kind=${k.kind}`)}>kind {kindLabel(k)}</a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      {meta.tags.length > 0 && (
        <div>
          <dt>{ui.detail.tags}</dt>
          <dd>
            <ul class="chips" data-testid="nip-tags">
              {meta.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      {meta.messages.length > 0 && (
        <div>
          <dt>{ui.detail.messages}</dt>
          <dd>
            <ul class="chips" data-testid="nip-messages">
              {meta.messages.map((m) => (
                <li class="chip" title={m.description}>
                  {m.type}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      {meta.updatedAt !== null && (
        <div>
          <dt>{ui.detail.lastChanged}</dt>
          <dd>{formatDate(locale, Date.parse(meta.updatedAt))}</dd>
        </div>
      )}
    </dl>
  </section>

  {meta.movedTo !== undefined && (
    <p class="notice" data-testid="nip-moved">
      <a href={href(locale, `nips/${meta.movedTo}`)}>
        {format(ui.detail.movedTo, { id: meta.movedTo })}
      </a>
    </p>
  )}
  {meta.unrecommended !== undefined && (
    <div class="notice" data-testid="nip-unrecommended">
      <p>{format(ui.detail.unrecommended, { reason: meta.unrecommended.reason })}</p>
      {meta.unrecommended.replacedBy.length > 0 && (
        <p>
          {ui.detail.replacedBy}:{" "}
          {meta.unrecommended.replacedBy.map((r, i) => (
            <>
              {i > 0 && ", "}
              <a href={href(locale, `nips/${r}`)}>NIP-{r}</a>
            </>
          ))}
        </p>
      )}
    </div>
  )}

  <section class="block editor" aria-labelledby="nip-editor-heading">
    <h2 id="nip-editor-heading">{ui.detail.editorHeading}</h2>
    {spec.todo === true ? (
      <p class="notice" data-testid="nip-todo">
        {ui.detail.todo}
      </p>
    ) : (
      <>
        <p class="lede">{ui.detail.editorIntro}</p>
        <div class="editor-frame">
          {/* client:idle, not :visible: the editor is the point of the page, and its SSR tabs look
              tappable, so a tap right after a deep link or "Show it in the editor" must not be lost. */}
          <NipEditor client:idle testid="nip-editor" locale={locale} spec={spec} />
        </div>
      </>
    )}
  </section>

  <div class="columns">
    <section class="block" aria-labelledby="nip-course-heading" data-testid="nip-course">
      <h2 id="nip-course-heading">{ui.detail.course}</h2>
      {courseLinks.length > 0 ? (
        <ul class="links">
          {courseLinks.map((c) => (
            <li>
              <a href={c.href} data-testid={`nip-course-${c.nn}`}>
                {format(ui.detail.courseChapter, { nn: c.nn, title: c.title })}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">{ui.detail.notInCourse}</p>
      )}
    </section>

    {related.length > 0 && (
      <section class="block" aria-labelledby="nip-related-heading" data-testid="nip-related">
        <h2 id="nip-related-heading">{ui.detail.related}</h2>
        {related.map((group) => (
          <div class="group">
            <h3 class="eyebrow">{ui.detail.relations[group.relation]}</h3>
            <ul class="links">
              {group.entries.map((r) => (
                <li>
                  <a href={href(locale, `nips/${r.nip}`)} data-testid={`nip-related-${r.nip}`}>
                    <span class="mono">NIP-{r.nip}</span> {nipTitle(r.nip)}
                  </a>
                  {r.explain !== undefined && <p class="muted small explain">{r.explain}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}
  </div>

  <section class="block spec" aria-labelledby="nip-spec-heading" data-testid="nip-spec">
    <h2 id="nip-spec-heading">{ui.detail.specification}</h2>
    <p class="muted small">
      {ui.proseNote}
      {" "}
      <a href={meta.url} rel="external noopener" data-testid="nip-github"
        >{format(ui.detail.githubPinned, { commit: shortCommit })}</a
      >
    </p>
    <details class="spec-details" data-testid="nip-spec-details">
      <summary data-testid="nip-spec-toggle">
        <span class="summary-title">{ui.detail.readTheSpec}</span>
        <span class="muted small"
          >{format(ui.detail.specHint, {
            words: formatNumber(locale, meta.wordCount),
            commit: shortCommit,
          })}</span
        >
      </summary>
      <div class="prose" lang="en" set:html={specHtml} />
    </details>
  </section>

  <nav class="pager" aria-label={ui.detail.pager} data-testid="nip-pager">
    {prev !== undefined && (
      <a class="page prev" href={href(locale, `nips/${prev}`)} rel="prev" data-testid="nip-prev">
        <span class="eyebrow">← {ui.detail.previous}</span>
        <span>
          NIP-{prev} · {nipTitle(prev)}
        </span>
      </a>
    )}
    {next !== undefined && (
      <a class="page next" href={href(locale, `nips/${next}`)} rel="next" data-testid="nip-next">
        <span class="eyebrow">{ui.detail.next} →</span>
        <span>
          NIP-{next} · {nipTitle(next)}
        </span>
      </a>
    )}
  </nav>
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-touch-target);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }
  .head {
    margin-block: var(--space-sm) var(--space-lg);
  }
  .head .eyebrow {
    margin: 0 0 var(--space-2xs);
  }
  h1 {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--font-letter-spacing-display);
    line-height: var(--font-line-height-tight);
    overflow-wrap: anywhere;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-sm);
  }
  .badge,
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-xs);
    border: var(--border-width-thin) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
  }
  .badge {
    padding-block: var(--space-3xs);
    box-shadow: var(--shadow-pop-sm);
  }
  .status.final {
    background: var(--color-success-subtle);
  }
  .status.draft {
    background: var(--color-info-subtle);
  }
  .status.unrecommended {
    background: var(--color-warning-subtle);
  }
  .status.deprecated {
    background: var(--color-surface-sunken);
  }
  .summary {
    margin: 0;
    max-inline-size: var(--size-content);
    font-size: var(--font-size-lg);
  }

  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-rail)), 1fr));
    gap: var(--space-sm) var(--space-lg);
    margin: 0 0 var(--space-lg);
    padding: var(--space-md);
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .facts dt {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--font-letter-spacing-caps);
    color: var(--color-text-muted);
  }
  .facts dd {
    margin: var(--space-3xs) 0 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    overflow-wrap: anywhere;
  }
  .chip a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-touch-target);
    color: var(--color-text-primary);
  }

  .notice {
    max-inline-size: var(--size-content);
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-warning-subtle);
  }
  .notice p {
    margin: 0;
  }
  .notice p + p {
    margin-block-start: var(--space-2xs);
  }

  .block {
    margin-block-start: var(--space-2xl);
    min-inline-size: 0;
  }
  .block h2 {
    margin: 0 0 var(--space-sm);
    padding-block-start: var(--space-sm);
    border-block-start: var(--border-width-thick) solid var(--color-border-strong);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-black);
  }
  .lede {
    margin: 0 0 var(--space-md);
    max-inline-size: var(--size-content);
  }
  /* Reserve room so the editor island doesn't shift the page when it hydrates. */
  .editor-frame {
    min-block-size: var(--size-diagram-min-height);
    min-inline-size: 0;
  }
  .columns {
    display: grid;
    gap: 0 var(--space-xl);
  }
  /* md (tokens.breakpoint.md = 768px): course and related side by side. */
  @media (min-width: 768px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .group + .group {
    margin-block-start: var(--space-md);
  }
  .group h3 {
    margin: 0 0 var(--space-2xs);
  }
  .links {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--size-touch-target);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
  }
  .explain {
    margin: 0 0 var(--space-xs);
  }
  .mono {
    font-family: var(--font-family-mono);
  }
  .muted {
    color: var(--color-text-muted);
  }
  .small {
    font-size: var(--font-size-sm);
  }
  .spec .muted.small {
    margin: 0 0 var(--space-md);
    max-inline-size: var(--size-content);
  }
  .spec a {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .spec-details {
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .spec-details > summary {
    display: grid;
    gap: var(--space-3xs);
    min-block-size: var(--size-touch-target);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    list-style: none;
  }
  .spec-details > summary::-webkit-details-marker {
    display: none;
  }
  .summary-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }
  .summary-title::before {
    content: "+ ";
    font-family: var(--font-family-mono);
    color: var(--color-text-primary);
  }
  .spec-details[open] .summary-title::before {
    content: "− ";
  }
  .spec-details[open] > summary {
    border-block-end: var(--border-width-medium) solid var(--color-border-strong);
  }
  .spec-details .muted.small {
    margin: 0;
  }
  .prose {
    max-inline-size: var(--size-content);
    padding: var(--space-md);
    overflow-wrap: anywhere;
  }
  /* Spec code blocks and tables scroll inside themselves so they never widen the page on phones. */
  .prose :global(pre),
  .prose :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
  }
  .prose :global(pre) {
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-code-bg);
    color: var(--color-code-text);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-normal);
    overflow-wrap: normal;
  }
  .prose :global(a) {
    color: var(--color-text-primary);
  }

  .pager {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-2xl);
  }
  /* sm (tokens.breakpoint.sm = 480px): previous and next side by side. */
  @media (min-width: 480px) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .page {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width-medium) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    overflow-wrap: anywhere;
    box-shadow: var(--shadow-pop-sm);
    transition:
      translate var(--motion-duration-press) var(--motion-easing-press),
      box-shadow var(--motion-duration-press) var(--motion-easing-press);
  }
  .page:hover,
  .page:focus-visible {
    translate: calc(var(--size-lift) * -1) calc(var(--size-lift) * -1);
    box-shadow: var(--shadow-lift);
  }
  .page:active {
    translate: var(--size-lift) var(--size-lift);
    box-shadow: var(--shadow-pressed);
  }
  .next {
    grid-column: -2;
    text-align: end;
  }
</style>
