---
/** Owner: shell agent. Tools index: standalone versions of the course interactives. */
import { getDictionary } from "@nostrschool/i18n";
import ToolCards from "~/components/shell/ToolCards.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { assertLocale, localeStaticPaths } from "~/lib/locale";

export const getStaticPaths = localeStaticPaths;
const locale = assertLocale(Astro.params.locale);
const t = getDictionary(locale).common;
---

<BaseLayout locale={locale} title={t.tools.title}>
  <h1 data-testid="tools-title">{t.tools.title}</h1>
  <p class="intro">{t.tools.intro}</p>
  <ToolCards locale={locale} headingLevel={2} />
</BaseLayout>

<style>
  h1 {
    margin: 0 0 var(--space-xs);
    padding-block-end: var(--space-xs);
    border-block-end: var(--border-width-thick) solid var(--color-border-strong);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-black);
  }
  .intro {
    margin: var(--space-sm) 0 var(--space-xl);
    max-inline-size: var(--size-content);
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }
</style>
