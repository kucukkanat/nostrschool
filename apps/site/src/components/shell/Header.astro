---
/**
 * Site header: logo, primary nav, live-mode switch, theme switch, language switcher.
 * Always one row of `--size-header` (it is sticky, so every extra row costs reading space on
 * phones). Below tokens.breakpoint.lg the live/theme/locale controls move into a native popover
 * behind a settings button: no JavaScript needed, and the nav links stay visible. While live mode
 * is on, the button itself carries a LIVE tag so the mode stays unmissable with the menu closed.
 */
import { getDictionary, LOCALE_NAMES, LOCALES, type Locale } from "@nostrschool/i18n";
import { href, switchLocale } from "~/lib/href";
import LiveToggle from "./LiveToggle.svelte";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.svelte";

interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale).common;
const path = Astro.url.pathname;
const sections = [
  { id: "learn", label: t.nav.learn },
  { id: "tools", label: t.nav.tools },
  { id: "glossary", label: t.nav.glossary },
] as const;
const isActive = (id: string) => path.startsWith(href(locale, id));
---

<header class="site-header" data-testid="site-header">
  <div class="inner">
    <Logo locale={locale} />
    <nav class="primary" aria-label={t.nav.primary} data-testid="nav-primary">
      {sections.map((s) => (
        <a
          href={href(locale, s.id)}
          data-testid={`nav-${s.id}`}
          aria-current={isActive(s.id) ? "page" : undefined}
        >
          {s.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="settings-toggle"
      popovertarget="header-settings"
      data-testid="header-settings-toggle"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h10M18 7h2M4 17h2M10 17h10"></path>
        <circle cx="16" cy="7" r="2"></circle>
        <circle cx="8" cy="17" r="2"></circle>
      </svg>
      <span class="visually-hidden">{t.nav.menu}</span>
      <span class="settings-live" data-testid="header-settings-live">{t.live.on}</span>
    </button>
    <div class="controls" id="header-settings" popover data-testid="header-settings">
      <LiveToggle client:load locale={locale} />
      <ThemeToggle client:load locale={locale} />
      <nav class="locales" aria-label={t.nav.language} data-testid="locale-switcher">
        {LOCALES.map((l) => (
          <a
            href={switchLocale(path, l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? "true" : undefined}
            data-testid={`locale-${l}`}
          >
            <span aria-hidden="true">{l.toUpperCase()}</span>
            <span class="visually-hidden">{LOCALE_NAMES[l]}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background: var(--color-surface);
    border-block-end: var(--border-width-medium) solid var(--color-text);
    view-transition-name: site-header;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    /* --size-header includes the bottom border; the row gets the rest. */
    block-size: calc(var(--size-header) - var(--border-width-medium));
    max-inline-size: var(--size-wide);
    margin-inline: auto;
    padding: 0 var(--space-md);
  }
  .primary {
    display: flex;
    flex: 1;
    gap: var(--space-3xs);
    min-inline-size: 0;
    /* Long translations scroll inside the nav instead of widening the page. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .primary a,
  .locales a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-control-sm);
    padding: 0 var(--space-sm);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background var(--motion-duration-fast) var(--motion-easing-standard),
      transform var(--motion-duration-normal) var(--motion-easing-bounce);
  }
  .primary a:hover,
  .locales a:hover {
    background: var(--color-primary-subtle);
    transform: translateY(calc(var(--space-3xs) * -1));
  }
  .primary a[aria-current="page"] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .settings-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--size-touch-target);
    min-inline-size: var(--size-touch-target);
    justify-content: center;
    padding: 0 var(--space-xs);
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    cursor: pointer;
  }
  .settings-toggle svg {
    inline-size: var(--size-icon-md);
    block-size: var(--size-icon-md);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .settings-live {
    display: none;
    padding: 0 var(--space-2xs);
    border-radius: var(--radius-pill);
    background: var(--color-live);
    color: var(--color-on-live);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--font-letter-spacing-caps);
  }
  :global(html[data-live="on"]) .settings-live {
    display: inline;
  }
  /* Below lg the controls are a popover; the UA keeps it display:none until opened. */
  .controls:popover-open {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    position: fixed;
    inset: var(--size-header) var(--space-md) auto auto;
    margin: var(--space-xs) 0 0;
    padding: var(--space-md);
    border: var(--border-width-medium) solid var(--color-text);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-pop-sm);
  }
  .locales {
    display: flex;
    padding: var(--space-3xs);
    border-radius: var(--radius-pill);
    border: var(--border-width-thin) solid var(--color-border);
    background: var(--color-surface-sunken);
  }
  .locales a {
    padding: 0 var(--space-xs);
    font-size: var(--font-size-sm);
  }
  .locales a[aria-current="true"] {
    background: var(--color-text);
    color: var(--color-surface);
  }
  .inner > :global(.logo) {
    flex: none;
  }
  /* < tokens.breakpoint.md: the mark alone; the name stays as the link's accessible text. */
  @media (max-width: 767px) {
    .inner > :global(.logo) :global(.word) {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* >= tokens.breakpoint.lg: controls sit inline; the popover is never opened (no toggle). */
  @media (min-width: 1024px) {
    .settings-toggle {
      display: none;
    }
    .controls {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      position: static;
      inset: auto;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      overflow: visible;
    }
  }
</style>
