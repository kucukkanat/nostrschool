---
/**
 * Logo mark + wordmark. The mark is the favicon drawn with tokens: an orange tile with an ink
 * outline and an ink "N", printed slightly off a teal plate (riso misregistration). On hover the
 * plates drift a little further apart. The mark is decorative; the link's text is the site name.
 */
import { getDictionary, type Locale } from "@nostrschool/i18n";
import { href } from "~/lib/href";

interface Props {
  readonly locale: Locale;
  readonly testid?: string;
}
const { locale, testid = "site-logo" } = Astro.props;
const name = getDictionary(locale).common.site.name;
const [first = name, ...rest] = name.split(" ");
---

<a class="logo" href={href(locale)} data-testid={testid}>
  <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect class="plate" x="9" y="9" width="51" height="51" rx="3"></rect>
    <g class="print">
      <rect class="tile" x="3" y="3" width="51" height="51" rx="3"></rect>
      <path class="letter" d="M17 42V16l23 26V16"></path>
    </g>
  </svg>
  <span class="word"
    ><span class="first">{first}</span>{rest.length > 0 && " "}<span class="rest"
      >{rest.join(" ")}</span
    ></span
  >
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--size-touch-target);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--font-letter-spacing-tight);
    white-space: nowrap;
  }
  .mark {
    flex: none;
    inline-size: var(--size-control-md);
    block-size: var(--size-control-md);
    overflow: visible;
  }
  .plate {
    fill: var(--color-secondary);
  }
  .print {
    transition: translate var(--motion-duration-normal) var(--motion-easing-bounce);
  }
  /* In SVG user units, so the print plate slips a few units further off the teal one. */
  .logo:hover .print {
    translate: calc(var(--size-lift) * -1) calc(var(--size-lift) * -1);
  }
  .tile {
    fill: var(--color-primary);
    stroke: var(--color-border-strong);
    stroke-width: 3;
  }
  .letter {
    fill: none;
    stroke: var(--color-on-primary);
    stroke-width: 6;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .rest {
    color: var(--color-text-primary);
  }
</style>
