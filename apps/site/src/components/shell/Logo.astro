---
/** Logo mark + wordmark. The mark is decorative; the link's text is the site name. */
import { getDictionary, type Locale } from "@nostrschool/i18n";
import { href } from "~/lib/href";

interface Props {
  readonly locale: Locale;
  readonly testid?: string;
}
const { locale, testid = "site-logo" } = Astro.props;
const name = getDictionary(locale).common.site.name;
const [first = name, ...rest] = name.split(" ");
---

<a class="logo" href={href(locale)} data-testid={testid}>
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect class="tile" x="2" y="2" width="36" height="36" rx="11"></rect>
    <path class="letter" d="M13 28V12l14 16V12"></path>
    <circle class="spark" cx="31" cy="9" r="4"></circle>
  </svg>
  <span class="word"
    ><span class="first">{first}</span>{rest.length > 0 && " "}<span class="rest"
      >{rest.join(" ")}</span
    ></span
  >
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--font-letter-spacing-tight);
    white-space: nowrap;
  }
  .mark {
    inline-size: var(--size-control-md);
    block-size: var(--size-control-md);
    transition: transform var(--motion-duration-slow) var(--motion-easing-bounce);
  }
  .logo:hover .mark {
    transform: rotate(-10deg) scale(1.08);
  }
  .tile {
    fill: var(--color-primary);
    stroke: var(--color-text);
    stroke-width: 2.5;
  }
  .letter {
    fill: none;
    stroke: var(--color-on-primary);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark {
    fill: var(--color-accent);
    stroke: var(--color-text);
    stroke-width: 2;
  }
  .rest {
    color: var(--color-text-primary);
  }
</style>
