{
  "name": "@nostrschool/test-relay",
  "version": "0.0.0",
  "private": true,
  "description": "In-memory NIP-01 relay for integration and E2E tests",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@nostrschool/fixtures": "workspace:*",
    "@nostrschool/protocol": "workspace:*"
  }
}
