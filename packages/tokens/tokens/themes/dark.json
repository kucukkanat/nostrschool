      "$value": "1px 1px 0 0 {color.shadow-pop}"
    },
    "md": {
      "$value": "3px 3px 0 0 {color.shadow-pop}"
    },
    "lg": {
      "$value": "5px 5px 0 0 {color.shadow-pop}"
    },
    "pop": {
      "$value": "3px 3px 0 0 {color.shadow-pop}",
      "$description": "Default card/button shadow."
    },
    "pop-sm": {
      "$value": "2px 2px 0 0 {color.shadow-pop}"
    },
    "lift": {
      "$value": "5px 5px 0 0 {color.shadow-pop}",
      "$description": "Hover: element lifts (translate -2px) and the offset grows."
    },
    "pressed": {
      "$value": "0 0 0 0 {color.shadow-pop}",
      "$description": "Active: the shadow collapses (translate by the pop offset)."
    },
    "accent": {
      "$value": "3px 3px 0 0 {color.shadow-accent}",
      "$description": "Orange misregistration for featured cards/selected state."
    },
    "focus-halo": {
      "$value": "0 0 0 2px {color.focus-halo}",
      "$description": "Pair with the focus outline when the ring sits on a fill."
