    },
    "pressed": {
      "$value": "0 0 0 0 {color.shadow-pop}",
      "$description": "Active: the shadow collapses (translate by the pop offset)."
    },
    "accent": {
      "$value": "3px 3px 0 0 {color.shadow-accent}",
      "$description": "Orange misregistration for featured cards/selected state."
    },
