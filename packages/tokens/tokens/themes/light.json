      "$value": "1px 1px 0 0 {color.shadow-pop}"
    },
    "md": {
      "$value": "3px 3px 0 0 {color.shadow-pop}"
    },
    "lg": {
      "$value": "5px 5px 0 0 {color.shadow-pop}"
    },
    "pop": {
      "$value": "3px 3px 0 0 {color.shadow-pop}",
