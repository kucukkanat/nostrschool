{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Bricolage Grotesque Variable",
          "Bricolage Grotesque",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Variable (wght 200\u2013800, opsz 12\u201396): headings get the quirky display cut via font-optical-sizing."
      },
      "body": {
        "$value": [
          "Bricolage Grotesque Variable",
          "Bricolage Grotesque",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono Variable",
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid type: rem + vw preferred values keep browser zoom working (WCAG 1.4.4). Min = 320px phone, max \u2248 1280px.",
      "2xs": {
        "$value": "0.6875rem"
      },
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "clamp(1.0625rem, 1.03rem + 0.16vw, 1.15rem)"
      },
      "xl": {
        "$value": "clamp(1.125rem, 1.06rem + 0.32vw, 1.3125rem)"
      },
      "2xl": {
        "$value": "clamp(1.25rem, 1.12rem + 0.64vw, 1.625rem)"
      },
      "3xl": {
        "$value": "clamp(1.5rem, 1.33rem + 0.84vw, 2rem)"
      },
      "4xl": {
        "$value": "clamp(1.75rem, 1.45rem + 1.5vw, 2.625rem)"
      },
      "5xl": {
        "$value": "clamp(2.125rem, 1.65rem + 2.4vw, 3.5rem)"
      },
      "6xl": {
        "$value": "clamp(2.5rem, 1.75rem + 3.75vw, 4.75rem)"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.08
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.55
      },
      "relaxed": {
        "$value": 1.75
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.04em"
      },
      "caps": {
        "$value": "0.08em"
      },
      "display": {
        "$value": "-0.035em",
        "$description": "Large editorial headings (4xl+)."
      }
    }
  }
}
