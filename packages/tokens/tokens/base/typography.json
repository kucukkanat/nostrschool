{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fredoka Variable", "Fredoka", "ui-rounded", "system-ui", "sans-serif"] },
      "body": { "$value": ["Nunito Variable", "Nunito", "ui-rounded", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "0.6875rem" },
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" },
      "5xl": { "$value": "3rem" },
      "6xl": { "$value": "3.75rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 800 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.55 },
      "relaxed": { "$value": 1.75 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" },
      "caps": { "$value": "0.08em" }
    }
  }
}
