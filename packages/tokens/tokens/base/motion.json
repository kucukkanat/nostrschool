{
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "All durations collapse to 0ms under prefers-reduced-motion (see generated CSS).",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "120ms" },
      "normal": { "$value": "220ms" },
      "slow": { "$value": "360ms" },
      "slower": { "$value": "600ms" },
      "packet": { "$value": "900ms", "$description": "One packet flight in sequence diagrams." },
      "step": { "$value": "1400ms", "$description": "Autoplay interval between diagram steps." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "bounce": { "$value": [0.34, 1.56, 0.64, 1] }
    },
    "spring": {
      "$type": "spring",
      "$description": "Spring presets for the motion library (stiffness/damping/mass).",
      "gentle": { "$value": { "stiffness": 120, "damping": 14, "mass": 1 } },
      "bouncy": { "$value": { "stiffness": 300, "damping": 12, "mass": 1 } },
      "snappy": { "$value": { "stiffness": 500, "damping": 30, "mass": 1 } },
      "wobbly": { "$value": { "stiffness": 180, "damping": 8, "mass": 1 } }
    }
  }
}
